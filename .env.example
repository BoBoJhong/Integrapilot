# Google Gemini（透過 LiteLLM）
GOOGLE_API_KEY=

# 模型名稱（LiteLLM 格式）
MODEL=gemini/gemini-2.5-flash

# PostgreSQL 連線字串（建議）
# Docker compose 預設可用：postgresql://integrapilot:integrapilot@db:5432/integrapilot
# 本機若直接連 Docker Desktop 可用：postgresql://integrapilot:integrapilot@localhost:5432/integrapilot
# DATABASE_URL=postgresql://integrapilot:integrapilot@db:5432/integrapilot

# （選用）Docker 掛載在「容器內」的路徑，須與 docker -v 右側一致
# MOUNT_PATH_A=/projA
# MOUNT_PATH_B=/projB

# （選用）僅供 UI 顯示：Windows 主機上的資料夾路徑，方便對照
# MOUNT_HOST_HINT_A=C:\Users\You\project-a
# MOUNT_HOST_HINT_B=C:\Users\You\project-b

# （選用）評估輸入上限（0 或 -1 表示不限制；可能增加成本與延遲）
# ASSESS_MAX_TREE_ENTRIES=250
# ASSESS_MAX_KEY_FILES=30
# ASSESS_MAX_FILE_CHARS=4000
# ASSESS_MAX_SNAPSHOT_CHARS=30000
# ASSESS_MAX_EVIDENCE_FILES=25
